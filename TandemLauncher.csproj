<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Tandem Launcher</AssemblyName>
    <RootNamespace>Tandem</RootNamespace>
    <ApplicationIcon>Assets\tandem.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Tandem Launcher</Product>
    <Description>Launcher and mod manager for the Scarlet / Violet native PC ports</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\tandem.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.10" />
  </ItemGroup>

</Project>

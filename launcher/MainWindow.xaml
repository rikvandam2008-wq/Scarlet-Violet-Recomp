                        own copies of the games.
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <!-- status line -->
            <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,9">
                <DockPanel>
                    <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="220" Height="6" Visibility="Collapsed"
                                 Foreground="{DynamicResource Accent}" Background="{StaticResource Panel2}" BorderThickness="0" Maximum="1"/>
                    <TextBlock x:Name="StatusLine" Style="{StaticResource Caption}" Foreground="{StaticResource Soft}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
